# Firebase Web (configuracao publica do aplicativo Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=gastos-simples-8bd4e
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=/api

# Backend: configure como secrets/variaveis do Cloudflare, nunca em VITE_*
# FIREBASE_PROJECT_ID=gastos-simples-8bd4e
# ADMIN_FIREBASE_UIDS=
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_PUBLIC_KEY=
# MERCADO_PAGO_PLAN_ID=
# MERCADO_PAGO_WEBHOOK_SECRET=
# MERCADO_PAGO_TEST_PAYER_EMAIL=test_payer_123456789@testuser.com
# Use MERCADO_PAGO_TEST_PAYER_EMAIL somente no sandbox local; nunca em produção.
# Opcional: alguns fluxos de Assinaturas não disponibilizam segredo de webhook.
# Sem ele, o backend reconsulta o recurso e valida conta, plano, UID, rate limit e idempotência.
# APP_ORIGIN=http://localhost:5173
