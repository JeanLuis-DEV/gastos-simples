# Firebase Web (configuracao publica do aplicativo Web)
VITE_FIREBASE_API_KEY=
# Produção: gastos.centralsimples.com.br (proxy same-origin em /__/auth/*)
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=gastos-simples-8bd4e
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=/api
# Fundação local disponível; transporte remoto permanece desativado nesta fase.
VITE_SYNC_ENABLED=false
VITE_SYNC_PRIVACY_POLICY_URL=

# Backend: configure como secrets/variaveis do Cloudflare, nunca em VITE_*
# FIREBASE_PROJECT_ID=gastos-simples-8bd4e
# ADMIN_FIREBASE_UIDS=
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_PUBLIC_KEY=
# MERCADO_PAGO_PLAN_ID=
# MERCADO_PAGO_WEBHOOK_SECRET=
# MERCADO_PAGO_TEST_PAYER_EMAIL=test_payer_123456789@testuser.com
# Use MERCADO_PAGO_TEST_PAYER_EMAIL somente no sandbox local; nunca em produção.
# Opcional: alguns fluxos de Assinaturas não disponibilizam segredo de webhook.
# Sem ele, o backend reconsulta o recurso e valida conta, plano, UID, rate limit e idempotência.
# APP_ORIGIN=http://localhost:5173
# Kill switch do backend; ausência ou qualquer valor diferente de "true" mantém a sincronização indisponível.
# SYNC_ENABLED=false
# Versão pública esperada; manter ausente até a política correspondente estar publicada.
# SYNC_POLICY_VERSION=2026.09.15-sync.1
# Canary inicial: quando "true", somente UIDs presentes no secret ADMIN_FIREBASE_UIDS podem ativar ou enviar dados.
# SYNC_CANARY_ADMIN_ONLY=true
# Identificador não secreto da chave ativa. O mapa JSON com chaves AES-256 deve existir somente como secret do Cloudflare.
# SYNC_ACTIVE_KEY_ID=
# SYNC_ENCRYPTION_KEYS={"key-id":"base64-de-32-bytes"}
